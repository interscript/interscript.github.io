---
// Neural models demo (TODO.client-work 08/11): live diacritization in
// the browser — verified Release fetch, download-once cache, streaming
// decode with per-step confidence. No server round-trip.
import Base from "../layouts/Base.astro"
---

<Base title="Neural models demo">
  <section class="page-narrow">
    <h1>Neural models demo</h1>
    <p>
      Authority-backed diacritization and vocalization running locally in your browser, off the main
      thread. The model downloads once (content-verified), then works offline.
    </p>
    <noscript>
      <p>This demo needs JavaScript.</p>
    </noscript>

    <label for="model">Model</label>
    <select id="model">
      <option value="heb-vocalized-plane-3.0" data-kind="plane">
        Hebrew vocalization — plane-3.0 (int8, 397 MB)
      </option>
      <option value="urd-vocalized-2.0" data-kind="imf">
        Urdu vocalization — 2.0 (int8, 249 MB)
      </option>
      <option value="ara-diac-layerdrop-1.0-int4" data-kind="imf">
        Arabic diacritization — lite (int4, 95 MB)
      </option>
      <option value="ara-diac-small-2.1-int8" data-kind="imf">
        Arabic diacritization — 2.1 (int8, 264 MB)
      </option>
      <option value="ara-diac-small-2.0-int8" data-kind="imf">
        Arabic diacritization — 2.0 (int8, 264 MB)
      </option>
      <option value="ara-diac-small-1.0-int8" data-kind="imf">
        Arabic diacritization — 1.0 (int8, 264 MB)
      </option>
      <option value="tha-g2p-small-1.0" data-kind="imf">
        Thai G2P — small (int8, 202 MB)
      </option>
    </select>
    <p class="tier-hint">
      Full-set numbers for every tier — the leaderboard and the client ladder — on{" "}
      <a href="/ml#leaderboard">the neural layer page</a>.
    </p>

    <label for="input">Input</label>
    <textarea id="input" rows="4" dir="auto">السلام عليكم ورحمة الله</textarea>

    <button id="run" class="btn">
      Transliterate
    </button>
    <button id="clear-cache" class="btn">
      Clear cached models
    </button>

    <div id="progress" hidden>
      <div class="progress-track">
        <div id="progress-bar" class="progress-fill"></div>
      </div>
      <span id="progress-label"></span>
    </div>

    <label for="output">Output</label>
    <output id="output" dir="auto"></output>
    <p id="confidence" class="muted" hidden></p>
  </section>
</Base>

<style>
  .tier-hint {
    font-size: 0.8125rem;
    opacity: 0.72;
    margin: 0.4rem 0 1.25rem;
  }
  .tier-hint a {
    text-decoration: underline;
  }
  .progress-track {
    height: 8px;
    background: rgba(128, 128, 128, 0.25);
    border-radius: 4px;
    overflow: hidden;
    margin: 0.75rem 0;
  }
  .progress-fill {
    height: 100%;
    width: 0%;
    background: #008075;
    transition: width 0.2s ease;
  }
  #output {
    display: block;
    min-height: 3rem;
    padding: 0.6rem;
    border: 1px solid rgba(128, 128, 128, 0.4);
    border-radius: 6px;
    font-size: 1.15rem;
    white-space: pre-wrap;
  }
  .low-conf {
    background: rgba(200, 120, 0, 0.25);
    border-radius: 3px;
  }
  .muted {
    color: #5c6470;
    font-size: 0.85rem;
  }
  label {
    display: block;
    margin: 0.75rem 0 0.25rem;
    font-weight: 600;
  }
  select,
  textarea {
    width: 100%;
    padding: 0.5rem;
    border-radius: 6px;
    border: 1px solid rgba(128, 128, 128, 0.4);
  }
  .btn {
    margin: 0.75rem 0.5rem 0.75rem 0;
  }
</style>

<script>
  import { createVocalizationClient, type VocalizationClient } from "../scripts/vocalization-client"

  // Built-in examples are the frozen conformance vectors — the same
  // rows the runtimes are gated to reproduce byte-exactly (the Hebrew
  // one is the /ml quickstart row).
  const EXAMPLES: Record<string, string> = {
    "heb-vocalized-plane-3.0": "ואם הזה, כשר",
    "urd-vocalized-2.0": "فاسد العقیدہ",
    "ara-diac-layerdrop-1.0-int4": "السلام عليكم ورحمة الله",
    "ara-diac-small-2.1-int8": "السلام عليكم ورحمة الله",
    "ara-diac-small-2.0-int8": "السلام عليكم ورحمة الله",
    "ara-diac-small-1.0-int8": "السلام عليكم ورحمة الله",
    "tha-g2p-small-1.0": "ก",
  }

  const $ = (id: string) => document.getElementById(id)!
  const client: VocalizationClient = createVocalizationClient()

  function selected(): { id: string; kind: "plane" | "imf" } {
    const option = ($("model") as HTMLSelectElement).selectedOptions[0]!
    return { id: option.value, kind: (option.dataset["kind"] as "plane" | "imf") ?? "imf" }
  }

  // Switching models swaps in that model's conformance example.
  $("model").addEventListener("change", () => {
    const input = $("input") as HTMLTextAreaElement
    input.value = EXAMPLES[selected().id] ?? ""
    $("confidence").hidden = true
    $("confidence").textContent = ""
  })

  $("run").addEventListener("click", async () => {
    const progress = $("progress")
    const bar = $("progress-bar")
    const label = $("progress-label")
    const out = $("output")
    const conf = $("confidence")
    out.textContent = ""
    conf.hidden = true
    conf.textContent = ""
    const { id, kind } = selected()
    try {
      progress.hidden = false
      label.textContent = "Resolving verified index…"
      const info = await client.load(id, kind, (fraction, bytes) => {
        bar.style.width = `${Math.round(fraction * 100)}%`
        label.textContent = `${(bytes / 1e6).toFixed(0)} MB (${Math.round(fraction * 100)}%)`
      })
      label.textContent = info.kPasses
        ? `Decoding (${info.kPasses} mask-predict passes)…`
        : "Decoding…"
      const stats = await client.transform(id, kind, ($("input") as HTMLTextAreaElement).value)
      out.textContent = stats.output
      const gap = stats.minGap !== undefined ? ` · min top-2 gap ${stats.minGap.toFixed(2)}` : ""
      conf.hidden = false
      conf.textContent = `decode ${stats.ms} ms in-worker${gap} (lower gap = more certain)`
    } catch (e) {
      out.textContent = `Error: ${(e as Error).message}`
    } finally {
      progress.hidden = true
    }
  })

  $("clear-cache").addEventListener("click", async () => {
    if (typeof caches !== "undefined") await caches.delete("interscript-imf-models-v1")
    $("confidence").hidden = true
    $("confidence").textContent = "Model cache cleared — next run re-downloads."
  })
</script>
