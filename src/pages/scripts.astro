---
import Base from "../layouts/Base.astro"
import catalogue from "../data/maps-catalogue.json" with { type: "json" }
import { scriptName, scriptNumber } from "../data/iso"

interface MapEntry {
  data: {
    authority_id: string
    source_script: string
    destination_script: string
    name: string
    language?: string
  }
  test?: (string | null)[]
}

// Aggregate: for each source script, collect one representative system + sample.
const byScript = new Map<
  string,
  {
    code: string
    name: string
    number?: string | number
    systems: { code: string; authority: string; name: string }[]
    sample?: { input: string; output: string; system: string }
  }
>()

for (const [code, entryRaw] of Object.entries(catalogue)) {
  const entry = entryRaw as MapEntry
  const ss = entry.data.source_script
  if (ss === entry.data.destination_script) continue // skip same-script (e.g. Latn→Latn)
  if (!byScript.has(ss)) {
    byScript.set(ss, {
      code: ss,
      name: scriptName(ss),
      number: scriptNumber(ss),
      systems: [],
    })
  }
  const bucket = byScript.get(ss)!
  bucket.systems.push({
    code,
    authority: entry.data.authority_id,
    name: entry.data.name,
  })
  // Use the first system with a test vector as the representative sample.
  if (!bucket.sample && entry.test && entry.test[0] && entry.test[1]) {
    bucket.sample = {
      input: entry.test[0] as string,
      output: entry.test[1] as string,
      system: code,
    }
  }
}

// Sort scripts alphabetically by display name; keep only scripts with samples.
const scripts = [...byScript.values()]
  .filter((s) => s.sample)
  .sort((a, b) => a.name.localeCompare(b.name))
---

<Base
  title="Scripts encyclopedia — Interscript"
  description="Visual gallery of every script Interscript handles, with a sample transliteration for each."
>
  <section class="scripts-hero">
    <div class="container">
      <p class="eyebrow eyebrow-accent">Scripts encyclopedia</p>
      <h1>Every script we romanize.</h1>
      <p class="hero-deck">
        A visual reference for the {scripts.length} ISO 15924 scripts
        Interscript currently covers. Each card shows a real sample
        word in the source script alongside its Latin rendering — the
        same pair checked into the test suite.
      </p>
    </div>
  </section>

  <section class="container scripts-grid-wrap">
    <ul class="scripts-grid">
      {scripts.map((s) => (
        <li class="script-card">
          <header class="card-head">
            <span class="card-name">{s.name}</span>
            <span class="card-code">{s.code}{s.number !== undefined && ` · ${s.number}`}</span>
          </header>

          <a class="card-sample" href={`/maps/${s.sample!.system}`}>
            <p class="sample-source">{s.sample!.input}</p>
            <p class="sample-arrow" aria-hidden="true">↓</p>
            <p class="sample-target">{s.sample!.output}</p>
          </a>

          <footer class="card-foot">
            <details>
              <summary>{s.systems.length} system{s.systems.length > 1 ? "s" : ""} for this script</summary>
              <ul class="systems-list">
                {s.systems.map((sys) => (
                  <li>
                    <a href={`/maps/${sys.code}`}>
                      <span class="sys-auth">{sys.authority}</span>
                      <span class="sys-name">{sys.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </footer>
        </li>
      ))}
    </ul>
  </section>

  <section class="section glossary surface-deep">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Reference</p>
        <h2>ISO 15924 script codes.</h2>
        <p class="section-deck">
          Every script code used by Interscript maps to an entry in
          ISO 15924 (Codes for the identification of scripts). Names
          and numeric identifiers are resolved at build time via <code>@iso24229/iso15924-data</code> from npm.
        </p>
      </header>

      <table class="glossary-table">
        <thead>
          <tr>
            <th>Code</th>
            <th>Number</th>
            <th>Name</th>
            <th>Systems</th>
          </tr>
        </thead>
        <tbody>
          {scripts.sort((a, b) => a.code.localeCompare(b.code)).map((s) => (
            <tr>
              <td><code>{s.code}</code></td>
              <td class="tnum">{s.number ?? "—"}</td>
              <td>{s.name}</td>
              <td class="tnum">{s.systems.length}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>

<style>
  .scripts-hero {
    padding-block: 4rem 2.5rem;
  }
  .scripts-hero h1 {
    font-size: var(--text-hero);
    margin: 1rem 0 1.25rem;
  }
  .hero-deck {
    max-width: 48rem;
    font-size: var(--text-lead);
    color: var(--color-stone);
    line-height: 1.6;
    margin: 0;
  }
  .scripts-grid-wrap {
    margin-block: 2rem 5rem;
  }

  .scripts-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .script-card {
    background: var(--color-vellum);
    border: 1px solid var(--color-rule);
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s ease;
  }
  .script-card:hover { border-color: var(--color-brand); }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .card-name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }
  .card-code {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-stone);
    letter-spacing: 0.04em;
  }

  .card-sample {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.5rem 1rem;
    text-decoration: none;
    color: inherit;
    flex: 1;
    background: var(--color-paper-deep);
    transition: background 0.15s ease;
  }
  .card-sample:hover { background: color-mix(in srgb, var(--color-brand) 12%, var(--color-paper-deep)); }
  .sample-source {
    font-family: var(--font-display);
    font-size: 1.625rem;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.1;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    text-align: center;
    word-break: break-word;
  }
  .sample-arrow {
    color: var(--color-highlight);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    margin: 0;
  }
  .sample-target {
    font-family: var(--font-display);
    font-size: 1.375rem;
    color: var(--color-highlight);
    font-style: italic;
    margin: 0;
    line-height: 1.1;
    text-align: center;
    word-break: break-word;
  }

  .card-foot {
    border-top: 1px solid var(--color-rule);
    padding: 0.625rem 1rem;
    font-size: 0.8rem;
  }
  .card-foot summary {
    cursor: pointer;
    color: var(--color-stone);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    list-style: none;
  }
  .card-foot summary::-webkit-details-marker { display: none; }
  .card-foot summary::before {
    content: "+ ";
    color: var(--color-brand-deep);
  }
  .card-foot details[open] summary::before { content: "− "; }

  .systems-list {
    list-style: none;
    padding: 0.5rem 0 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .systems-list a {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-ink);
    font-size: 0.78rem;
    padding: 0.2rem 0;
  }
  .systems-list a:hover .sys-name { color: var(--color-highlight); }
  .sys-auth {
    font-family: var(--font-mono);
    color: var(--color-brand-deep);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .sys-name {
    font-family: var(--font-sans);
    color: var(--color-stone);
    text-align: right;
  }

  .glossary-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 2rem;
    font-size: 0.9rem;
  }
  .glossary-table th {
    text-align: left;
    padding: 0.75rem 0.5rem;
    border-bottom: 2px solid var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-stone);
    font-weight: 500;
  }
  .glossary-table td {
    padding: 0.625rem 0.5rem;
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-ink);
  }
  .glossary-table td code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background: transparent;
    color: var(--color-brand-deep);
    padding: 0;
  }
</style>
