---
import Base from "../../layouts/Base.astro"
import { renderAsciiDocDir } from "../../content/loaders/asciidoc"

const docs = renderAsciiDocDir("src/content/docs")
---

<Base title="Docs — Interscript" description="Documentation for the Interscript transliteration project.">
  <h1>Documentation</h1>

  <section class="quickstart">
    <h2>Getting started</h2>
    <p>
      Interscript runs in Ruby and TypeScript. Both consume the same
      authority-backed maps.
    </p>
    <div class="runtime-tiles">
      <div class="tile">
        <h3>Ruby</h3>
        <pre><code>gem install interscript
interscript -s bgnpcgn-ukr-Cyrl-Latn-2019 &lt;&lt;&lt; "Антон"
# => Anton</code></pre>
        <a href="/docs/Integration_with_Ruby_Applications">Ruby guide →</a>
      </div>
      <div class="tile">
        <h3>TypeScript</h3>
        <pre><code>npm install interscript-ts</code></pre>
        <pre><code>import &#123; transliterate &#125; from "interscript-ts"
transliterate("bgnpcgn-ukr-Cyrl-Latn-2019", "Антон")
// => "Anton"</code></pre>
      </div>
    </div>
  </section>

  <section class="docs-list">
    <h2>All docs</h2>
    <ul>
      {docs.map((d) => (
        <li>
          <a href={`/docs/${d.id}`}>
            <span class="title">{d.data.title}</span>
            {d.data.summary && <span class="summary">{d.data.summary}</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="external">
    <h2>Source</h2>
    <p>
      <a href="https://github.com/interscript/interscript">GitHub monorepo</a>
      tracks the project architecture and TODO list.
    </p>
    <p>
      <a href="https://github.com/interscript/maps">Map corpus</a>
      holds the 300+ `.imp` files; each one is human-readable Ruby DSL.
    </p>
  </section>
</Base>

<style>
  .quickstart {
    margin: 2rem 0;
  }
  .runtime-tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 768px) {
    .runtime-tiles {
      grid-template-columns: 1fr;
    }
  }
  .tile {
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    padding: 1.5rem;
  }
  .tile h3 {
    margin-top: 0;
  }
  .tile pre {
    background: var(--color-vellum);
    padding: 0.75rem;
    border-radius: 6px;
    overflow-x: auto;
    margin: 0.5rem 0;
  }
  .docs-list {
    margin: 3rem 0;
  }
  .docs-list ul {
    list-style: none;
    padding: 0;
  }
  .docs-list li {
    border-bottom: 1px solid var(--color-rule);
  }
  .docs-list a {
    display: block;
    padding: 1rem 0;
    color: var(--color-ink);
    text-decoration: none;
  }
  .docs-list a:hover .title {
    color: var(--color-brand);
  }
  .docs-list .title {
    display: block;
    font-weight: 600;
  }
  .docs-list .summary {
    display: block;
    color: var(--color-stone);
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }
  .external {
    margin-top: 3rem;
  }
  .external a {
    color: var(--color-brand);
  }
</style>
