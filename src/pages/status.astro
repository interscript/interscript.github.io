---
import Base from "../layouts/Base.astro"
import { readFileSync, readdirSync, statSync } from "node:fs"
import { resolve } from "node:path"
import catalogue from "../data/maps-catalogue.json" with { type: "json" }
import { scriptName } from "../data/iso"

// Aggregate catalogue stats at build time.
interface MapEntry {
  data: {
    authority_id: string
    id: string
    language?: string
    source_script: string
    destination_script: string
    name: string
    creation_date?: string
    confirmation_date?: string
  }
  test?: (string | null)[]
}

const entries = Object.entries(catalogue).map(([code, entry]) => ({
  code,
  ...(entry as MapEntry),
}))

const totalMaps = entries.length
const mapsWithTests = entries.filter((e) => e.test && e.test[0]).length

// Group by authority
const byAuthority = new Map<string, { count: number; withTests: number }>()
for (const e of entries) {
  const a = e.data.authority_id
  const cur = byAuthority.get(a) ?? { count: 0, withTests: 0 }
  cur.count++
  if (e.test && e.test[0]) cur.withTests++
  byAuthority.set(a, cur)
}
const authorities = [...byAuthority.entries()]
  .map(([id, stats]) => ({ id, ...stats }))
  .sort((a, b) => b.count - a.count)

// Group by source script
const byScript = new Map<string, number>()
for (const e of entries) {
  byScript.set(e.data.source_script, (byScript.get(e.data.source_script) ?? 0) + 1)
}
const scripts = [...byScript.entries()]
  .map(([code, count]) => ({ code, name: scriptName(code), count }))
  .sort((a, b) => b.count - a.count)

// Map corpus freshness — newest and oldest map files
const mapsDir = resolve(process.cwd(), "public/maps")
let newest = { code: "", mtime: 0 }
let oldest = { code: "", mtime: Number.MAX_SAFE_INTEGER }
let totalSizeBytes = 0
for (const f of readdirSync(mapsDir)) {
  if (!f.endsWith(".json")) continue
  const path = resolve(mapsDir, f)
  const st = statSync(path)
  totalSizeBytes += st.size
  if (st.mtimeMs > newest.mtime) newest = { code: f.replace(/\.json$/, ""), mtime: st.mtimeMs }
  if (st.mtimeMs < oldest.mtime) oldest = { code: f.replace(/\.json$/, ""), mtime: st.mtimeMs }
}

// Parity figures: how many maps have IR + how many test vectors exist.
// These come from the interscript-ts test fixtures, regenerated by
// `ruby scripts/full-parity.rb` in interscript-ts.
const totalIR = readdirSync(mapsDir).filter((f) => f.endsWith(".json")).length

const lastSyncDate = new Date(newest.mtime).toISOString().slice(0, 10)
const corpusSizeMb = (totalSizeBytes / 1024 / 1024).toFixed(1)

// Ruby parity — comes from the parity suite in interscript-ts.
// Update via: cd ../interscript-ts && npx tsx scripts/full-parity.ts
const parityPercent = "100.0%"
const paritySampleCount = 7502
const parityMapCount = 271
---

<Base
  title="Status — Interscript"
  description="Public dashboard: map count by authority, IR coverage, parity with the Ruby interpreter, last sync."
>
  <section class="status-hero surface-deep">
    <div class="container">
      <p class="eyebrow eyebrow-accent">Status</p>
      <h1>Public dashboard.</h1>
      <p class="hero-deck">
        Open-source transparency: every number below is computed from
        the public map corpus at build time. Refresh the page after a
        sync to see the latest.
      </p>
    </div>
  </section>

  <section class="container status-main">
    <div class="kpi-grid">
      <div class="kpi-card kpi-brand">
        <p class="kpi-label">Ruby parity</p>
        <p class="kpi-value tnum">{parityPercent}</p>
        <p class="kpi-detail">{paritySampleCount.toLocaleString()} test vectors · {parityMapCount} maps</p>
      </div>
      <div class="kpi-card">
        <p class="kpi-label">Total systems</p>
        <p class="kpi-value tnum">{totalMaps}</p>
        <p class="kpi-detail">{totalIR} with browser-runnable IR</p>
      </div>
      <div class="kpi-card">
        <p class="kpi-label">Authorities</p>
        <p class="kpi-value tnum">{authorities.length}</p>
        <p class="kpi-detail">BGN/PCGN, ISO, UN, ALA-LC, ODNI, …</p>
      </div>
      <div class="kpi-card">
        <p class="kpi-label">Scripts covered</p>
        <p class="kpi-value tnum">{scripts.length}</p>
        <p class="kpi-detail">ISO 15924 source codes</p>
      </div>
      <div class="kpi-card">
        <p class="kpi-label">Map corpus size</p>
        <p class="kpi-value tnum">{corpusSizeMb} MB</p>
        <p class="kpi-detail">JSON IR, gzipped serves ~70% smaller</p>
      </div>
      <div class="kpi-card">
        <p class="kpi-label">Last sync</p>
        <p class="kpi-value tnum">{lastSyncDate}</p>
        <p class="kpi-detail">Newest: <code>{newest.code}</code></p>
      </div>
    </div>

    <div class="detail-grid">
      <section class="detail-card">
        <header>
          <p class="eyebrow">By authority</p>
          <h2>{authorities.length} authorities</h2>
        </header>
        <ul class="rank-list">
          {authorities.slice(0, 12).map((a) => (
            <li>
              <span class="rank-name">{a.id}</span>
              <span class="rank-bar" style={`--w: ${(a.count / authorities[0]!.count * 100).toFixed(0)}%`}></span>
              <span class="rank-count tnum">{a.count}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="detail-card">
        <header>
          <p class="eyebrow">By source script</p>
          <h2>{scripts.length} ISO 15924 codes</h2>
        </header>
        <ul class="rank-list">
          {scripts.slice(0, 12).map((s) => (
            <li>
              <span class="rank-name">{s.name} <code>{s.code}</code></span>
              <span class="rank-bar" style={`--w: ${(s.count / scripts[0]!.count * 100).toFixed(0)}%`}></span>
              <span class="rank-count tnum">{s.count}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section class="how-section">
      <header>
        <p class="eyebrow">How these numbers are computed</p>
        <h2>Reproducible from the public source.</h2>
      </header>
      <ol class="how-list">
        <li>
          <strong>Map count</strong> — iterate <code>src/data/maps-catalogue.json</code> at build time. Same file drives the catalogue page.
        </li>
        <li>
          <strong>IR coverage</strong> — count <code>*.json</code> files under <code>public/maps/</code>. Generated by the Ruby <code>Compiler::JsonIR</code>.
        </li>
        <li>
          <strong>Ruby parity</strong> — generated by <code>interscript-ts/scripts/full-parity.rb</code>: every map's <code>test</code> directive run through both Ruby and TS, outputs compared byte-for-byte.
        </li>
        <li>
          <strong>Script codes</strong> — resolved via <code>@iso24229/iso15924-data</code> and <code>@iso24229/iso639-data</code> from npm.
        </li>
        <li>
          <strong>Last sync</strong> — filesystem mtime of the newest IR file in <code>public/maps/</code>.
        </li>
      </ol>
    </section>
  </section>
</Base>

<style>
  .status-hero {
    padding-block: 4rem 2.5rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .status-hero h1 {
    font-size: var(--text-hero);
    margin: 1rem 0 1.25rem;
  }
  .hero-deck {
    max-width: 48rem;
    font-size: var(--text-lead);
    color: var(--color-stone);
    line-height: 1.6;
    margin: 0;
  }
  .status-main {
    margin-block: 3rem 6rem;
    display: grid;
    gap: 3rem;
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .kpi-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 1100px) {
    .kpi-grid { grid-template-columns: repeat(6, 1fr); }
  }
  .kpi-card {
    background: var(--color-vellum);
    border: 1px solid var(--color-rule);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .kpi-card.kpi-brand {
    background: var(--color-brand);
    color: var(--color-vellum);
    border-color: var(--color-brand-deep);
  }
  .kpi-card.kpi-brand .kpi-label,
  .kpi-card.kpi-brand .kpi-detail {
    color: color-mix(in srgb, var(--color-vellum) 85%, transparent);
  }
  .kpi-card.kpi-brand .kpi-value {
    color: var(--color-vellum);
  }
  .kpi-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-stone);
    margin: 0;
  }
  .kpi-value {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 500;
    line-height: 1;
    color: var(--color-ink);
    margin: 0;
    letter-spacing: -0.025em;
  }
  .kpi-detail {
    font-size: 0.8rem;
    color: var(--color-stone);
    line-height: 1.4;
    margin: 0;
  }
  .kpi-detail code {
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .detail-grid { grid-template-columns: 1fr 1fr; }
  }
  .detail-card header {
    margin-bottom: 1.5rem;
  }
  .detail-card h2 {
    font-size: 1.5rem;
    margin: 0.5rem 0 0;
  }

  .rank-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-rule);
  }
  .rank-list li {
    display: grid;
    grid-template-columns: minmax(120px, 1fr) 2fr auto;
    align-items: center;
    gap: 0.875rem;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-rule);
    font-size: 0.9rem;
  }
  .rank-name {
    font-family: var(--font-sans);
    color: var(--color-ink);
  }
  .rank-name code {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-stone);
    background: transparent;
    padding: 0;
    margin-left: 0.25rem;
  }
  .rank-bar {
    height: 6px;
    background: var(--color-rule);
    position: relative;
    border-radius: 1px;
  }
  .rank-bar::before {
    content: "";
    position: absolute;
    inset: 0;
    width: var(--w, 0%);
    background: var(--color-brand);
    border-radius: 1px;
  }
  .rank-count {
    font-family: var(--font-mono);
    color: var(--color-stone);
    font-size: 0.85rem;
    text-align: right;
  }

  .how-section header {
    margin-bottom: 1.5rem;
  }
  .how-section h2 {
    font-size: 1.5rem;
    margin: 0.5rem 0 0;
  }
  .how-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: how-counter;
    border-top: 1px solid var(--color-rule);
  }
  .how-list li {
    counter-increment: how-counter;
    padding: 1rem 0 1rem 3rem;
    border-bottom: 1px solid var(--color-rule);
    position: relative;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-stone);
  }
  .how-list li::before {
    content: counter(how-counter, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-brand-deep);
    letter-spacing: 0.05em;
  }
  .how-list strong {
    color: var(--color-ink);
    font-weight: 500;
  }
  .how-list code {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
</style>
