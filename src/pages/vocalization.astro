---
import Base from "../layouts/Base.astro"

// Facts verified 2026-11-25 against the primary sources, not memory:
// - releases heb-vocalized-plane-3.0 + urd-vocalized-2.0 + urd-vocalized-2.1
//   (github.com/interscript/interscript-models)
// - index-v18 models-index.yaml (release asset + sha256 sidecar)
// - models#488 (SOTA-2027 Persian poetry vocalization campaign, owner-approved)
// - urdu-dev#17 + urdu-dev#23-#26 (Clause 16(e) calibrated matched-split instrument)
const models = [
  {
    id: "heb-vocalized-plane-3.0",
    language: "Hebrew",
    pair: "Hebr → Hebr",
    kind: "plane (mask-predict)",
    result: "DER 6.6078",
    gate: "crown gate 8.18 cleared, −1.57pp",
    method: "curriculum weak→gold",
    artifact: "int8-dynamic · 397 MiB",
    release:
      "https://github.com/interscript/interscript-models/releases/tag/heb-vocalized-plane-3.0",
    hf: "https://huggingface.co/Interscript/heb-vocalized-plane-3.0",
    index:
      "https://github.com/interscript/interscript-models/releases/tag/index-v18",
  },
  {
    id: "urd-vocalized-2.1",
    language: "Urdu",
    pair: "Arab → Arab",
    kind: "seq2seq (ByT5-small)",
    result: "CER 3.632%",
    gate: "gate 3.77% PASS · champion 3.74% beaten · distilled 3.641% beaten",
    method: "direct-gold (no teacher, single hop)",
    artifact: "int8-dynamic · 249 MiB",
    release:
      "https://github.com/interscript/interscript-models/releases/tag/urd-vocalized-2.1",
    hf: "https://huggingface.co/Interscript/urd-vocalized-2.1",
    index:
      "https://github.com/interscript/interscript-models/releases/tag/index-v18",
  },
  {
    id: "urd-vocalized-2.0",
    language: "Urdu",
    pair: "Arab → Arab",
    kind: "seq2seq (ByT5-small)",
    result: "CER 3.641%",
    gate: "gate 3.77% PASS · champion 3.74% beaten by 0.099pp",
    method: "clean-room distillation",
    artifact: "int8-dynamic · 249 MiB",
    release:
      "https://github.com/interscript/interscript-models/releases/tag/urd-vocalized-2.0",
    hf: "https://huggingface.co/Interscript/urd-vocalized-2.0",
    index:
      "https://github.com/interscript/interscript-models/releases/tag/index-v18",
  },
]
---

<Base
  title="The Interscript vocalization suite"
  description="The Interscript vocalization suite: Hebrew and Urdu vocalization models with measured gates and clean-room lineage, and the announced Persian campaign. One artifact format, sha256-verified, three runtimes."
>
  <!-- ════════════════════════════════════════════════════════════════
       HEADER
       ════════════════════════════════════════════════════════════════ -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow eyebrow-accent">The model family</p>
      <h1 class="page-headline">
        The Interscript <em>vocalization suite</em>.
      </h1>
      <p class="hero-lead">
        Vocalization is writing back in what a keyboard, a printing tradition, or a scribe left
        out: the nikud of unpointed Hebrew, the marks of bare Urdu. No committee publishes these
        conversions, so they are learned — and they ship under the same discipline as every
        Interscript model: a measured metric against a pre-registered gate, an artifact format
        verified by checksum, and byte-identical output from all three runtimes. This page is the
        family page; the full catalogue lives on <a href="/ml">the neural layer page</a>.
      </p>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       THE MODELS — per-model table
       ════════════════════════════════════════════════════════════════ -->
  <section class="section" id="models">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">The released models</p>
        <h2>Two languages shipped, each gated before release.</h2>
        <p class="section-deck">
          All ids resolve against the models.yaml index (index-v18), are mirrored on{" "}
          <a href="https://huggingface.co/Interscript">the Hugging Face Interscript org</a>, and
          carry BSD-3-Clause code and weights. Numbers below are quoted from the release records
          and the index — decode protocol included.
        </p>
      </header>

      <div class="table-wrap">
        <table class="suite-table">
          <thead>
            <tr>
              <th>Model</th>
              <th>Task</th>
              <th>Measured result</th>
              <th>Method</th>
              <th>Artifact</th>
              <th>Links</th>
            </tr>
          </thead>
          <tbody>
            {
              models.map((m) => (
                <tr>
                  <td>
                    <code class="model-id">
                      <a href={m.release}>{m.id}</a>
                    </code>
                    <span class="model-lang">{m.language}</span>
                  </td>
                  <td>
                    {m.pair}
                    <span class="model-kind">{m.kind}</span>
                  </td>
                  <td class="tnum">
                    <strong>{m.result}</strong>
                    <span class="gate">{m.gate}</span>
                  </td>
                  <td>{m.method}</td>
                  <td class="tnum">{m.artifact}</td>
                  <td class="links-cell">
                    <a href={m.release}>release</a> · <a href={m.hf}>HF mirror</a> ·{" "}
                    <a href={m.index}>index entry</a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="table-note">
        Hebrew: heb-vocalized-plane-3.0 is the WO92 gold-SFT stage over weak-pretrain
        (run-093→run-094) — DER 6.6078 against the crown gate 8.18, with the classification parity
        gate (DER-delta ≤ 0.25pp) measured at 0.0549pp over 600 samples
        (models<a
          href="https://github.com/interscript/interscript-models/pull/459"
          >#459</a
        >). Urdu: urd-vocalized-2.1 (run-097) is a ByT5-small trained directly on the human-verified
        gold pairs — no teacher, no distillation, single hop — scored on the full split, all 11,940
        held-out rows, greedy decode, WO37 protocol, at raw CER 3.632% against the pre-registered
        gate 3.77%; it beats both the shipped champion urd-vocalized-1.0 (3.74%) and the shipped
        distilled student urd-vocalized-2.0 (3.641%, listed above and still available) — the
        finding of record: human-verified gold labels beat distilled labels on the same corpus.
        int8 parity cer_delta 0.0671pp on 600 samples.
      </p>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       THE METHODS — how the family is trained
       ════════════════════════════════════════════════════════════════ -->
  <section class="section surface-deep" id="methods">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">The methods</p>
        <h2>Two validated training methods.</h2>
        <p class="section-deck">
          Each shipped model of the family was produced by one of two training methods, each
          validated by a gated measurement on its own language before release. Neither uses an
          LLM as a label source — language-model teachers hallucinate diacritics.
        </p>
      </header>

      <div class="method-grid">
        <div class="method-card">
          <h3>Curriculum weak→gold</h3>
          <p>
            Weak-pretrain on unvocalized text, then gold SFT on fully vocalized gold. Validated on
            Hebrew: the curriculum took the plane lineage from 8.18 to 6.6078 DER — the −1.57pp
            "curriculum verdict" of WO92 (run-093→run-094).
          </p>
        </div>
        <div class="method-card">
          <h3>Clean-room direct-gold / distill</h3>
          <p>
            Train on human-verified gold labels only — directly, or distilled through a teacher
            whose lineage is verified license-clean. The restricted corpus is never input, target,
            or label — the corpus overlap discriminator measured zero shared shingles. Validated on
            Urdu: run-097 direct-gold, CER 3.632% under the 3.77% gate — beating the distilled
            run-096 (3.641%) on the same corpus, confirming the gold-labels hypothesis.
          </p>
        </div>
      </div>

      <div class="gate-block">
        <h3>The license-cleanliness gate</h3>
        <p>
          "Clean-room" is a claim, so the family measures it. The instrument of record is the
          calibrated matched-split Clause 16(e) audit — a reference-calibrated membership-inference
          suite (urdu-dev<a href="https://github.com/interscript/urdu-dev/issues/17">#17</a>,
          matched-split methodology per{" "}
          <a href="https://github.com/interscript/urdu-dev/issues/23">urdu-dev#23</a>–<a
            href="https://github.com/interscript/urdu-dev/issues/26"
            >#26</a
          >) run against the trained artifact. For urd-vocalized-2.1 the calibrated AUC was 0.4816
          against chance 0.5 (tolerance 0.05), with a verbatim probe of 200 probes and 125
          extraction prompts producing zero violations — verdict PASS, records retained to
          2028-11-25 (urd-vocalized-2.0's own PASS at AUC 0.4933 is in its release record). The
          instrument, its falsification chain, and the ledger entries live in the{" "}
          <a href="https://github.com/interscript/urdu-dev">urdu-dev repository</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       COMING — Persian
       ════════════════════════════════════════════════════════════════ -->
  <section class="section" id="coming">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Coming — announced</p>
        <h2>Persian: the next member of the family.</h2>
        <p class="section-deck">
          Owner-approved public campaign (models<a
            href="https://github.com/interscript/interscript-models/issues/488"
            >#488</a
          >, sources approved 2026-11-24): Persian poetry vocalization under the working name
          fas-vocalized — the version number is stated at ship. The recipe is the Hebrew
          curriculum mapped to Persian: weak-pretrain on OSCAR-fa, gold SFT on Ganjoor poetry from
          license-clean sources (Ganjoor CC BY-SA 3.0, fa-Wikisource CC BY-SA 4.0). The measured
          headroom is the largest in the org — news CER 0.603% against poetry 33.67%, a 56×
          register gap (WO66) — and the register fine-tune precedent already halved poetry CER. It
          ships with an index entry and a Hugging Face mirror when its gates pass, gated by the
          same calibrated matched-split 16(e) methodology.
        </p>
      </header>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       GETTING STARTED — vocalization quickstart
       ════════════════════════════════════════════════════════════════ -->
  <section class="section surface-deep" id="getting-started">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Getting started</p>
        <h2>Vocalize, in three lines per runtime.</h2>
        <p class="section-deck">
          A vocalization id resolves against the models.yaml index, downloads once, and is
          sha256-verified on every load — then it runs locally, no server involved, with
          byte-identical output from TypeScript, Ruby, and Python. Both worked examples below are
          frozen conformance vectors from the models fixtures — unpointed text in, vocalized text
          out — so what your runtime prints can be diffed byte against byte.
        </p>
      </header>
      <div class="crystal-code">
        <pre><code>{`# install — the neural layer ships inside the same package
npm install interscript          # TypeScript / JavaScript
gem install interscript          # Ruby (onnxruntime loads lazily)
pip install "interscript[ml]"    # Python`}</code></pre>
        <pre><code>{`// TypeScript — heb-vocalized-plane-3.0 (plane, mask-predict)
import { imf, PlaneModel } from "interscript/ml"

const model = await PlaneModel.fromZip((await imf.resolve("heb-vocalized-plane-3.0")).bytes)
await model.transform("ואם הזה, כשר")
// → "\\u05d5\\u05b0\\u05d0\\u05b4\\u05dd \\u05d4\\u05b4\\u05d6\\u05bc\\u05b8\\u05d4, \\u05db\\u05bc\\u05b8\\u05e9\\u05c1\\u05b5\\u05e8"`}</code></pre>
        <pre><code>{`# Ruby
require "interscript/ml"

model = Interscript::ML::PlaneModel.from_zip(
  File.binread(Interscript::ML::IMF.resolve("heb-vocalized-plane-3.0")))
model.translate("ואם הזה, כשר")
# => "\\u05d5\\u05b0\\u05d0\\u05b4\\u05dd \\u05d4\\u05b4\\u05d6\\u05bc\\u05b8\\u05d4, \\u05db\\u05bc\\u05b8\\u05e9\\u05c1\\u05b5\\u05e8"`}</code></pre>
        <pre><code>{`# Python
import interscript

interscript.transliterate("heb-vocalized-plane-3.0", "ואם הזה, כשר")
# → "\\u05d5\\u05b0\\u05d0\\u05b4\\u05dd \\u05d4\\u05b4\\u05d6\\u05bc\\u05b8\\u05d4, \\u05db\\u05bc\\u05b8\\u05e9\\u05c1\\u05b5\\u05e8"`}</code></pre>
        <pre><code>{`// TypeScript — urd-vocalized-2.0 (seq2seq, ByT5-small)
import { imf } from "interscript/ml"

const model = await imf.IMFModel.load("urd-vocalized-2.0")
await model.translate("فاسد العقیدہ")
// → "\\u0641\\u0652\\u0627\\u0633\\u0652\\u062f\\u0650 \\u0627\\u0644\\u0652\\u0639\\u064f\\u0642\\u0652\\u06cc\\u062f\\u0652\\u06c1\\u064e"`}</code></pre>
        <pre><code>{`# Ruby
require "interscript/ml"

model = Interscript::ML::Translator.new(
  model_file: Interscript::ML::IMF.resolve("urd-vocalized-2.0"))
model.translate("فاسد العقیدہ")
# => "\\u0641\\u0652\\u0627\\u0633\\u0652\\u062f\\u0650 \\u0627\\u0644\\u0652\\u0639\\u064f\\u0642\\u0652\\u06cc\\u062f\\u0652\\u06c1\\u064e"`}</code></pre>
        <pre><code>{`# Python
import interscript

interscript.transliterate("urd-vocalized-2.0", "فاسد العقیدہ")
# → "\\u0641\\u0652\\u0627\\u0633\\u0652\\u062f\\u0650 \\u0627\\u0644\\u0652\\u0639\\u064f\\u0642\\u0652\\u06cc\\u062f\\u0652\\u06c1\\u064e"`}</code></pre>
      </div>
      <p class="env-note">
        The expected outputs are printed as <code>\u</code> escape sequences on purpose: Hebrew
        combining-mark order is bidi-fragile, and escapes let you diff the bytes your runtime
        produced against the frozen vector instead of trusting screen rendering. Both vectors are
        machine-checked in a real browser by the site's conformance gate,{" "}
        <a
          href="https://github.com/interscript/interscript.github.io/blob/main/e2e/neural-vocalization.spec.ts"
          >e2e/neural-vocalization.spec.ts</a
        > — run as <code>BROWSER_VOCAL_E2E=1 npx playwright test e2e/neural-vocalization.spec.ts</code>,
        it downloads the released artifacts through the <a href="/neural">/neural</a> demo's worker
        and asserts each output byte-exactly.
      </p>
      <p class="env-note">
        First use downloads the int8 artifact (397&nbsp;MiB for the Hebrew plane model,
        249&nbsp;MiB for either Urdu model) and caches it — point the cache at{" "}
        <code>INTERSCRIPT_ML_CACHE</code>; every later load re-verifies the sha256. Install lines,
        mirrors, and the REST endpoint <code>POST https://api.interscript.org/v1/infer</code> are
        documented in <a href="/ml#getting-started">Use the models</a> on{" "}
        <a href="/ml">the /ml page</a>.
      </p>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       PROVENANCE
       ════════════════════════════════════════════════════════════════ -->
  <section class="section cta surface-ink">
    <div class="container cta-grid">
      <div class="cta-text">
        <p class="eyebrow eyebrow-accent">Provenance</p>
        <h2>Every gate is pre-registered.</h2>
        <p class="cta-deck">
          Each model above carries its gate, its decode protocol, and its license audit in the open
          release records. BSD-3-Clause, code and weights. The full model catalogue — every
          language, every measured score — is on <a href="/ml">the neural layer page</a>.
        </p>
      </div>
      <div class="cta-code">
        <pre><code>github.com/interscript/interscript-models   # releases + index-v18
github.com/interscript/urdu-dev             # clause 16(e) instrument</code></pre>
      </div>
    </div>
  </section>
</Base>

