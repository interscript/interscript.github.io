---
import Base from "../layouts/Base.astro"
import MapExplorer from "../components/MapExplorer.vue"
import catalogue from "../data/maps-catalogue.json" with { type: "json" }

// Every shipped system, grouped by authority — the page is live
// transliteration over the whole corpus, not a curated sample.
const systems = Object.entries(catalogue).map(([code, entry]) => ({
  code,
  label: entry.data.name,
  group: entry.data.authority_id.toUpperCase(),
}))
const firstTest = (catalogue as Record<string, { test?: (string | null)[] }>)[systems[0].code]
  ?.test?.[0]
const initialInput = typeof firstTest === "string" ? firstTest : ""

const samples = [
  { system: "BGN/PCGN Ukrainian", input: "Антон", output: "Anton" },
  { system: "BGN/PCGN German", input: "Tschüß!", output: "Tschueß!" },
  { system: "ODNI Russian", input: "привет мир", output: "privet mir" },
  { system: "ALA-LC Amharic", input: "ኢትዮጵያ", output: "ʼiteyop̣eyā" },
  { system: "UN Tamil", input: "தமிழ்", output: "tamil̮" },
]
---

<Base
  title="Live transliteration — Interscript"
  description={`Transliterate any of ${systems.length} authority-backed systems live, in your browser, powered by interscript-ts.`}
>
  <section class="demo-hero">
    <div class="container">
      <p class="eyebrow">Live transliteration</p>
      <h1>Type. Watch scripts change.</h1>
      <p class="demo-deck">
        All {systems.length} systems, live. Transliterate through the Interscript API — or flip to in-browser
        mode to run the full engine locally with ISC maps. No analytics, no waiting.
      </p>
    </div>
  </section>

  <section class="container demo-main">
    <MapExplorer client:load systems={systems} initialInput={initialInput} />
  </section>

  <section class="container section-tight">
    <header class="section-head">
      <p class="eyebrow">Reference vectors</p>
      <h2>What each system should produce.</h2>
    </header>
    <table class="reference-table">
      <thead>
        <tr>
          <th>System</th>
          <th>Input</th>
          <th></th>
          <th>Output</th>
        </tr>
      </thead>
      <tbody>
        {
          samples.map((s) => (
            <tr>
              <td class="ref-name">{s.system}</td>
              <td class="ref-input">{s.input}</td>
              <td class="ref-arrow" aria-hidden="true">
                →
              </td>
              <td class="ref-output">{s.output}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</Base>

<style>
  .demo-hero {
    padding-block: 4rem 2rem;
  }
  .demo-hero h1 {
    font-size: var(--text-hero);
    margin: 0.75rem 0 1rem;
  }
  .demo-deck {
    max-width: 50ch;
    font-size: var(--text-lead);
    color: var(--color-stone);
  }
  .demo-main {
    margin-block: 2rem 4rem;
  }
  .section-head h2 {
    font-size: var(--text-h1);
    margin: 0.5rem 0 1.5rem;
  }
  .reference-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-display);
    font-size: 1.0625rem;
  }
  .reference-table th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-stone);
    padding: 0.5rem 1rem;
    border-bottom: 2px solid var(--color-ink);
  }
  .reference-table td {
    padding: 1rem;
    border-bottom: 1px solid var(--color-rule);
    vertical-align: middle;
  }
  .ref-name {
    color: var(--color-stone);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
  }
  .ref-input {
    color: var(--color-ink);
  }
  .ref-arrow {
    color: var(--color-stone-light);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .ref-output {
    color: var(--color-ochre);
    font-style: italic;
  }
</style>
