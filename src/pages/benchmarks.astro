---
import Base from "../layouts/Base.astro"
import data from "../data/benchmarks.json" with { type: "json" }
import ivrbData from "../data/ivrb.json" with { type: "json" }

interface DriverLeg {
  runs: number[]
  medianMs: number
  matched: number
  total: number
  divergent?: number
  perMapMeanMs?: number
  rowsPerSec?: number
  note?: string
}
interface CaptureLeg extends DriverLeg {
  rows: number
  maps: number
  loadErrors: number
}
interface DerivedLeg {
  rowsPerSec: number
  derivedFrom: string
}
interface Head {
  repo: string
  ref: string
  sha: string | null
  version: string | null
  note?: string
}

interface BenchData {
  generatedAt: string
  methodology: { runs: number; aggregation: string; serial: boolean; note: string }
  machine: {
    os: string
    arch: string
    cpuModel: string
    cores: number
    memoryGb: number
    node: string
    toolchains: { ruby: string | null; python: string | null }
  }
  runtimeHeads: Record<string, Head>
  corpus: { maps: number; goldenRows: number; fixtureRows: number; sha: string | null }
  parse: Record<string, DriverLeg>
  goldenReplay: Record<string, DriverLeg>
  fixtureThroughput: Record<string, DriverLeg | DerivedLeg>
}

const d = data as unknown as BenchData

interface IvrbSystem {
  rank: number
  system: string
  retention: string
  recoveryCer: string
  skelCer: string
  encodeRate: string
  markLeak: string
}
interface IvrbModel {
  id: string
  precision: string
  rows: number
  directCer: string
  systems: IvrbSystem[]
}
interface IvrbLanguage {
  rows: number
  rankingNote: string
  models: IvrbModel[]
}
interface IvrbData {
  protocol: string
  provenance: {
    repo: string
    docPath: string
    specPath: string
    decodeDates: string
  }
  crossval: {
    gate: string
    status: string
    agreement: string
    systems_checked: number
    checks_per_system: number
    sample_rows: number
    seed: number
    job: string
    record: string
    date: string
  }
  findings: { hebrewDirectCerInversion: string; hebrewMarkLeak: string }
  languages: Record<string, IvrbLanguage>
}

const iv = ivrbData as unknown as IvrbData
const ivrbLangLabels: Record<string, string> = { urd: "Urdu", heb: "Hebrew" }
const ivrbSourceUrl = (path: string): string =>
  `https://github.com/${iv.provenance.repo}/blob/main/${path}`

const ms = (v: number): string => `${Math.round(v).toLocaleString("en-US")} ms`
const secs = (v: number): string => `${(v / 1000).toFixed(v >= 10000 ? 1 : 2)} s`
const both = (v: number): string => `${ms(v)} (${secs(v)})`
const shortSha = (sha: string | null): string => (sha ? sha.slice(0, 10) : "—")
const headOf = (key: string): Head => d.runtimeHeads[key]!

const parseOrder = ["ts", "ruby", "py", "rs"] as const
const replayOrder = ["ts", "ruby", "py"] as const

const rsCapture = d.goldenReplay.rs as CaptureLeg
const rsTranslitOnly = rsCapture.medianMs - d.parse.rs!.medianMs

// The audit-day baseline is frozen by design: these are the audited
// clean serial series from interscript/maps docs/parity/README.md §A.8
// (2026-11-13), quoted verbatim for comparability. Current-HEAD numbers
// above come from the generated data file only.
const baseline = [
  {
    runtime: "ts (parseIsc)",
    runs: "16,742.8 / 15,826.8 / 15,986.5",
    median: 15986,
    perMap: 37,
  },
  {
    runtime: "py (parse_isc + resolver)",
    runs: "77,839.3 / 80,709.3 / 81,024.7",
    median: 80709,
    perMap: 189,
  },
  {
    runtime: "rs (iscrs parse, release, wall)",
    runs: "81,410 / 79,220 / 77,490",
    median: 79220,
    perMap: 185,
  },
  {
    runtime: "ruby (Interpreter.parse_isc)",
    runs: "186,029.0 / 156,782.2 / 161,449.9",
    median: 161450,
    perMap: 377,
  },
]

// The first runtime baselines are frozen by design: quoted verbatim from
// interscript-rs docs/benchmarks/BASELINES-2026-11.md (2026-11-21 run) —
// one-shot serial numbers, not medians; the protocol lives in the rs repo.
const firstBaselines = [
  {
    runtime: "Rust (interscript-rs)",
    coldLoad: "9.55",
    loaded: "456/457",
    rssLoad: "342.7",
    docsPerSec: "145.1",
    charsPerSec: "3,975",
    rssThroughput: "406.2",
    peakDoc: "318",
    rssPeak: "16.2",
  },
  {
    runtime: "TypeScript (interscript-ts)",
    coldLoad: "0.28",
    loaded: "457/457",
    rssLoad: "202.7",
    docsPerSec: "1,475.3",
    charsPerSec: "40,408",
    rssThroughput: "613.2",
    peakDoc: "22",
    rssPeak: "49.6",
  },
  {
    runtime: "Ruby (interscript-ruby)",
    coldLoad: "137.59",
    loaded: "457/457",
    rssLoad: "974.2",
    docsPerSec: "1,976.3",
    charsPerSec: "54,130",
    rssThroughput: "594.3",
    peakDoc: "863",
    rssPeak: "33.4",
  },
  {
    runtime: "Python (interscript-py)",
    coldLoad: "3.59",
    loaded: "435/457",
    rssLoad: "273.0",
    docsPerSec: "52.1",
    charsPerSec: "1,426",
    rssThroughput: "241.3",
    peakDoc: "42",
    rssPeak: "19.4",
  },
]
---

<Base
  title="Benchmarks — Interscript"
  description="Reproducible runtime benchmarks: corpus parse, golden replay, and fixed-input transliteration throughput across the four Interscript runtimes."
>
  <section class="bench-hero surface-deep">
    <div class="container">
      <p class="eyebrow eyebrow-accent">Benchmarks</p>
      <h1>Measured, not claimed.</h1>
      <p class="hero-deck">
        Corpus parse, golden replay, and fixed-input transliteration throughput for the four
        Interscript runtimes, generated by checked-in scripts — never hand-edited. The parity
        audit-day table is kept frozen below as the baseline; this page tracks current HEAD.
      </p>
    </div>
  </section>

  <section class="container bench-main">
    <div class="prose">
      <p>
        Generated <strong>{d.generatedAt}</strong> by <code>scripts/benchmarks/generate.mjs</code>:
        {d.methodology.runs} runs per leg, median aggregation, strictly serial (one runtime at a
        time, nothing else executing). The TS leg reads a built <code>dist</code>, the rs leg reads
        the release <code>iscrs</code> binary, and the ruby/py legs run in-process against sibling
        checkouts of the four runtime repos and the map corpus — every tree's exact commit is
        recorded below.
      </p>

      <table>
        <thead>
          <tr>
            <th>Runtime</th>
            <th>Repo / ref</th>
            <th>Commit</th>
            <th>Version</th>
          </tr>
        </thead>
        <tbody>
          {parseOrder.map((key) => {
            const h = headOf(key)
            return (
              <tr>
                <td>
                  <strong>{key}</strong>
                </td>
                <td>
                  {h.repo} <code>@{h.ref}</code>
                </td>
                <td>
                  <code>{shortSha(h.sha)}</code>
                </td>
                <td>{h.version ?? "—"}</td>
              </tr>
            )
          })}
        </tbody>
      </table>
      {headOf("py").note && <p class="fine-print">{headOf("py").note}</p>}

      <p class="fine-print">
        Machine: {d.machine.cpuModel}, {d.machine.cores} cores, {d.machine.memoryGb} GB,{" "}
        {d.machine.os} ({d.machine.arch}); node {d.machine.node}, ruby{" "}
        {d.machine.toolchains.ruby ?? "?"}, python {d.machine.toolchains.python ?? "?"}. Corpus:{" "}
        {d.corpus.maps} maps (maps@{shortSha(d.corpus.sha)}); golden capture {d.corpus.goldenRows}{" "}
        rows; fixed input set {d.corpus.fixtureRows} rows.
      </p>
    </div>

    <section class="detail-card">
      <header>
        <p class="eyebrow">Corpus parse</p>
        <h2>Parse every corpus map, median of {d.methodology.runs}</h2>
      </header>
      <div class="prose">
        <table>
          <thead>
            <tr>
              <th>Runtime</th>
              <th>Median</th>
              <th>Per-map mean</th>
              <th>Parsed</th>
              <th>Runs</th>
            </tr>
          </thead>
          <tbody>
            {parseOrder.map((key) => {
              const leg = d.parse[key]!
              return (
                <tr>
                  <td>{key}</td>
                  <td class="tnum">{both(leg.medianMs)}</td>
                  <td class="tnum">~{leg.perMapMeanMs} ms</td>
                  <td class="tnum">
                    {leg.matched}/{leg.total}
                  </td>
                  <td class="tnum">{leg.runs.map((r) => Math.round(r)).toLocaleString("en-US")}</td>
                </tr>
              )
            })}
          </tbody>
        </table>
        <p class="fine-print">{d.parse.rs!.note}</p>
      </div>
    </section>

    <section class="detail-card">
      <header>
        <p class="eyebrow">Golden replay</p>
        <h2>Replay the golden capture end to end</h2>
      </header>
      <div class="prose">
        <p>
          The cross-runtime contract is the RS golden capture (
          <code>interscript-rs tests/golden/isc-wf0.jsonl</code>, {d.corpus.goldenRows} rows). TS,
          ruby, and py replay it in-process (1 unmeasured warmup pass, then {d.methodology.runs}{" "}
          measured passes); rs runs its native single-process capture over the corpus' embedded
          tests, which includes the parse.
        </p>
        <table>
          <thead>
            <tr>
              <th>Runtime</th>
              <th>Median</th>
              <th>Byte-exact</th>
              <th>Note</th>
            </tr>
          </thead>
          <tbody>
            {replayOrder.map((key) => {
              const leg = d.goldenReplay[key]!
              return (
                <tr>
                  <td>{key}</td>
                  <td class="tnum">{both(leg.medianMs)}</td>
                  <td class="tnum">
                    {leg.matched.toLocaleString("en-US")}/{leg.total.toLocaleString("en-US")}
                    {leg.divergent ? (
                      <span class="fine-print"> ({leg.divergent} diverge)</span>
                    ) : null}
                  </td>
                  <td>in-process jsonl replay</td>
                </tr>
              )
            })}
            <tr>
              <td>rs</td>
              <td class="tnum">{both(rsCapture.medianMs)}</td>
              <td class="tnum">{rsCapture.rows} rows captured</td>
              <td>
                <code>iscrs capture</code> wall; translit-only ≈ {both(rsTranslitOnly)} after
                subtracting the parse median
              </td>
            </tr>
          </tbody>
        </table>
        {replayOrder.some((key) => (d.goldenReplay[key]?.divergent ?? 0) > 0) && (
          <p class="fine-print">
            Divergent rows are golden output mismatches (deterministic across passes; an execution
            error would fail the run outright rather than be reported). The three current py
            divergences are the <code>Ў</code> rows of the three thin ALA-LC Belarusian maps (
            <code>gki-bel</code>, <code>mvd-bel</code>, <code>odni-bel</code>) — the newest corpus
            additions, whose exhaustive per-row tests ts and ruby replay byte-exact.
          </p>
        )}
        <p class="fine-print">
          The byte-exact columns are a sanity signal, not the parity gate — conformance is enforced
          in each runtime's own CI (rs <code>golden_capture</code>, ts{" "}
          <code>test/golden-isc-wf0.test.ts</code>, py <code>test_golden_capture.py</code>).
        </p>
      </div>
    </section>

    <section class="detail-card">
      <header>
        <p class="eyebrow">Transliteration throughput</p>
        <h2>
          Fixed input set ({d.corpus.fixtureRows} rows), median of {d.methodology.runs}
        </h2>
      </header>
      <div class="prose">
        <p>
          The input set is committed at <code>scripts/benchmarks/fixtures/input-set.jsonl</code> —
          every 25th row of the golden capture, sampled once and then frozen so the series stays
          comparable as the golden evolves.
        </p>
        <table>
          <thead>
            <tr>
              <th>Runtime</th>
              <th>rows/s</th>
              <th>ms/row</th>
              <th>Source</th>
            </tr>
          </thead>
          <tbody>
            {replayOrder.map((key) => {
              const leg = d.fixtureThroughput[key] as DriverLeg
              return (
                <tr>
                  <td>{key}</td>
                  <td class="tnum">{Math.round(leg.rowsPerSec!).toLocaleString("en-US")}</td>
                  <td class="tnum">{(1000 / leg.rowsPerSec!).toFixed(2)}</td>
                  <td>in-process, fixture replay</td>
                </tr>
              )
            })}
            <tr>
              <td>rs</td>
              <td class="tnum">
                {Math.round((d.fixtureThroughput.rs as DerivedLeg).rowsPerSec).toLocaleString(
                  "en-US",
                )}
              </td>
              <td class="tnum">
                {(1000 / (d.fixtureThroughput.rs as DerivedLeg).rowsPerSec).toFixed(2)}
              </td>
              <td class="fine-print">derived from the capture leg — rs has no batch CLI</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="detail-card">
      <header>
        <p class="eyebrow">Audit-day baseline (frozen)</p>
        <h2>428-map corpus parse, 2026-11-13 audit</h2>
      </header>
      <div class="prose">
        <p>
          Quoted from the{" "}
          <a href="https://github.com/interscript/maps/blob/main/docs/parity/README.md">
            ISC runtime feature-parity audit
          </a>{" "}
          (§A.8, macOS 14, apple-silicon, clean serial runs). This table is the audit-day baseline
          and is kept unchanged; the tables above track current HEAD and are regenerated by script.
        </p>
        <table>
          <thead>
            <tr>
              <th>Runtime</th>
              <th>Runs (ms)</th>
              <th>Median</th>
              <th>Per-map mean</th>
            </tr>
          </thead>
          <tbody>
            {baseline.map((row) => (
              <tr>
                <td>{row.runtime}</td>
                <td class="tnum">{row.runs}</td>
                <td class="tnum">{both(row.median)}</td>
                <td class="tnum">~{row.perMap} ms</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="fine-print">
          Audit-day postscript (WO18): py's generated parser was later closure-compiled — controlled
          before/after showed roughly 78 s down to about 22 s per corpus pass, byte-identical
          output. The py row above reflects the pre-closure audit run.
        </p>
      </div>
    </section>

    <section class="detail-card">
      <header>
        <p class="eyebrow">First baselines (frozen)</p>
        <h2>Registry cold load, RSS, and end-to-end throughput — 2026-11-21</h2>
      </header>
      <div class="prose">
        <p>
          Quoted verbatim from{" "}
          <a href="https://github.com/interscript/interscript-rs/blob/main/docs/benchmarks/BASELINES-2026-11.md">
            interscript-rs <code>docs/benchmarks/BASELINES-2026-11.md</code>
          </a>{" "}
          (2026-11-21 run): the first measured baselines of the full registry path. One-shot serial
          run on an otherwise idle machine (Apple M1 Max, 10 cores, 64&nbsp;GB, macOS 14.1.1) —
          numbers are single-run baselines, not medians. All four runtimes loaded the same maps
          corpus pin (<code>9cfbf4cf</code>, 457 maps) and transliterated the same deterministic
          200-doc sample. Measure definitions and the runner interface: the{" "}
          <a href="https://github.com/interscript/interscript-rs/blob/main/docs/benchmarks/PROTOCOL.md">
            full protocol</a
          >.
        </p>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Runtime</th>
                <th>Cold load (s)</th>
                <th>Loaded</th>
                <th>RSS @ load (MB)</th>
                <th>Docs/sec</th>
                <th>Chars/sec</th>
                <th>RSS @ throughput (MB)</th>
                <th>Peak doc (ms)</th>
                <th>RSS @ peak (MB)</th>
              </tr>
            </thead>
            <tbody>
              {firstBaselines.map((row) => (
                <tr>
                  <td>{row.runtime}</td>
                  <td class="tnum">{row.coldLoad}</td>
                  <td class="tnum">{row.loaded}</td>
                  <td class="tnum">{row.rssLoad}</td>
                  <td class="tnum">{row.docsPerSec}</td>
                  <td class="tnum">{row.charsPerSec}</td>
                  <td class="tnum">{row.rssThroughput}</td>
                  <td class="tnum">{row.peakDoc}</td>
                  <td class="tnum">{row.rssPeak}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="fine-print">
          Definitions (from the protocol): <strong>cold load</strong> = a fresh process loading all
          457 maps through the runtime's standard registry path; <strong>docs/sec</strong> = warm
          throughput over the 200-doc set × 5 loops; <strong>peak doc</strong> = fresh-process load
          plus a single transliteration of the largest input doc; <strong>RSS</strong> = process
          resident set of the whole runner, so cross-runtime deltas include each interpreter's own
          baseline — per-runtime trends over time are the primary signal.
        </p>
        <p class="fine-print">
          Reading the spread: TypeScript's 0.28&nbsp;s cold load reads the pre-compiled JSON-IR
          artifact (deserialise + link, not ISC parsing); Ruby's 137.6&nbsp;s / 974&nbsp;MB is
          per-map parsanol compilation, after which it is the fastest runtime warm (1,976
          docs/sec); Rust parses <code>.isc</code> at load and cannot load one map whose{" "}
          <code>rababa</code> funcall needs external ML engines (unsupported in that slice, by
          design); the Python row is the pre-<code>#49</code> engine — 22 parser-gap maps did not
          load.
        </p>
        <p class="fine-print">
          Same-day refresh: after py caching (<code>#48</code>) and full parser coverage
          (<code>#49</code>), py loads 457/457, cold load 7.27&nbsp;s, and reaches 91.1 docs/sec
          (2,496 chars/sec) with zero errors — +75% warm throughput while decoding strictly more
          work (all 200 docs vs the baseline's 193); peak doc unchanged at 42&nbsp;ms. Per the
          baselines doc, that refresh number is not directly comparable to the baseline row — the
          honest statement is more work, fewer errors, on the same machine and corpus pin.
        </p>
      </div>
    </section>

    <section class="detail-card">
      <header>
        <p class="eyebrow">IVRB (vocalization benchmark)</p>
        <h2>How much diacritic information survives each romanization system</h2>
      </header>
      <div class="prose">
        <p>
          The Interscript Vocalization-Romanization Benchmark (protocol{" "}
          <code>{iv.protocol}</code>) asks, in the spec's words, "per romanization system, how much
          of that diacritic information survives the system and which systems preserve the most
          recoverable information" (IVRB-SPEC §1). Decoding is greedy single-row (base budgets urd
          256 / heb 512 new tokens; truncated rows re-decoded at ⌈1.2 × generated⌉, iterated),
          ONNXRuntime CPU single-thread; all CERs are corpus-level; retention = 1 − recovery CER /
          skeleton CER, both in the system's own Latin output space, and systems are ranked by it
          (SPEC §3.4). Tables below show retention; the numbers are transcribed verbatim from the
          merged results document.
        </p>
        {Object.entries(iv.languages).map(([lang, group]) => (
          <>
            <h3>
              {ivrbLangLabels[lang]!} — {group.rows.toLocaleString("en-US")} rows
            </h3>
            <p class="fine-print">
              Direct CER anchors (the model ceiling, <code>cer_nat</code>, reported beside every
              table):{" "}
              {group.models.map((m, i) => (
                <>
                  {i > 0 && "; "}
                  <code>{m.id}</code> ({m.precision}) {m.directCer}
                </>
              ))}
              .
            </p>
            <div class="table-scroll">
              <table>
                <thead>
                  <tr>
                    <th>Romanization system (ranked by retention)</th>
                    {group.models.map((m) => (
                      <th>
                        <code>{m.id}</code> ({m.precision})
                      </th>
                    ))}
                    <th>Mark leak</th>
                  </tr>
                </thead>
                <tbody>
                  {group.models[0]!.systems.map((sys) => (
                    <tr>
                      <td>
                        {sys.rank}. <code>{sys.system}</code>
                      </td>
                      {group.models.map((m) => {
                        const s = m.systems.find((x) => x.system === sys.system)!
                        return <td class="tnum">{s.retention}</td>
                      })}
                      <td class="tnum">{sys.markLeak}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="fine-print">
              Ranking ({group.rankingNote}):{" "}
              <code>{group.models[0]!.systems.map((s) => s.system).join(" > ")}</code>. Per-system
              recovery CER, skeleton CER, and encode rate accompany each row in{" "}
              <code>src/data/ivrb.json</code> and the results document; mark leak = rows whose Latin
              output leaks raw combining marks / total rows.
            </p>
          </>
        ))}
        <p class="fine-print">
          <strong>{iv.crossval.gate} cross-validation closed {iv.crossval.date}:</strong>{" "}
          {iv.crossval.systems_checked}/{iv.crossval.systems_checked} systems at 100% agreement
          (py engine vs iscrs, {iv.crossval.checks_per_system} checks per system,{" "}
          {iv.crossval.sample_rows} sampled rows/language, seed {iv.crossval.seed} pinned); ranking
          stands.
        </p>
        <p class="fine-print">{iv.findings.hebrewDirectCerInversion}</p>
        <p class="fine-print">{iv.findings.hebrewMarkLeak}</p>
        <p>
          Full protocol and metric definitions:{" "}
          <a href={ivrbSourceUrl(iv.provenance.specPath)}>IVRB-SPEC.md</a>; merged v1 results
          (decode records landed {iv.provenance.decodeDates}):{" "}
          <a href={ivrbSourceUrl(iv.provenance.docPath)}>RESULTS-v1.md</a> in{" "}
          <code>{iv.provenance.repo}</code>.
        </p>
      </div>
    </section>

    <section class="detail-card">
      <header>
        <p class="eyebrow">Reproduce</p>
        <h2>Exact commands</h2>
      </header>
      <div class="prose">
        <p>
          The scripts require sibling checkouts of the benchmarked trees — the map corpus (
          <code>maps</code>), <code>interscript-rs</code> (with a release build:{" "}
          <code>cargo build --release</code>), <code>interscript-ts</code> (with a built{" "}
          <code>dist/</code>), <code>interscript-ruby</code>, and the py ISC engine tree (the{" "}
          <code>wo17/py-override-placement</code> branch of the interscript-ruby repo, whose Python
          package lives at <code>interscript-py/</code> inside it). Override any location with the{" "}
          <code>INTERSCRIPT_MAPS</code>, <code>INTERSCRIPT_RS</code>, <code>INTERSCRIPT_TS</code>,{" "}
          <code>INTERSCRIPT_RUBY</code>, and <code>INTERSCRIPT_PY</code> environment variables.
        </p>
        <pre><code>{`# one-time: freeze the fixed input set from the rs golden capture
node scripts/benchmarks/make-fixture.mjs

# regenerate every number on this page (clean serial runs, ~30-60 min)
node scripts/benchmarks/generate.mjs

# the output lands in src/data/benchmarks.json — never hand-edit it;
# commit the regeneration with the runtime changes it measures`}</code></pre>
        <p class="fine-print">
          Methodology follows the parity audit's timing protocol (
          <code>maps/docs/parity/README.md</code> §A.8): median-of-3, in-process timing for the
          interpreted runtimes, wall clock for the rs CLI legs, strictly serial.
        </p>
      </div>
    </section>
  </section>
</Base>

<style>
  .bench-hero {
    padding-block: 4rem 2.5rem;
    border-bottom: 1px solid var(--color-rule);
