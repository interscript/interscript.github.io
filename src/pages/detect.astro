---
import Base from "../layouts/Base.astro"
import DetectPanel from "../components/DetectPanel.vue"
---

<Base
  title="Detect transliteration system — Interscript"
  description="Paste source + romanization, find which authority system best explains the pair. Powered by Levenshtein distance."
>
  <section class="detect-hero">
    <div class="container">
      <p class="eyebrow eyebrow-accent">Detection</p>
      <h1>Which system produced this romanization?</h1>
      <p class="hero-deck">
        Paste a source-script name and an observed Latin form. Interscript
        transliterates the source through every system in the family and
        ranks each by edit distance to your observation. The smallest
        distance is the most likely system.
      </p>
    </div>
  </section>

  <section class="container detect-main">
    <DetectPanel client:load />
  </section>

  <section class="section detect-why surface-deep">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Why detection matters</p>
        <h2>Attribution forensics for transliteration.</h2>
        <p class="section-deck">
          You find a romanized name in an old index, a citation, or a
          news archive — but you don't know which romanization system
          was used. Interscript's detector reverse-engineers the
          attribution by testing every plausible system.
        </p>
      </header>

      <div class="why-grid">
        <article>
          <h3>Provenance research</h3>
          <p>
            Trace which romanization system was applied to a historical
            record. Especially useful for archives that span multiple
            eras of cataloging practice.
          </p>
        </article>
        <article>
          <h3>Quality control</h3>
          <p>
            Verify that a romanization was applied consistently. If
            distance is high for every system, the source may have
            errors or use an undocumented convention.
          </p>
        </article>
        <article>
          <h3>Cross-system deduping</h3>
          <p>
            Detect when the same name surfaces under different
            romanizations across records — useful for entity resolution
            in news archives and library catalogs.
          </p>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .detect-hero {
    padding-block: 4rem 2.5rem;
  }
  .detect-hero h1 {
    font-size: var(--text-hero);
    margin: 1rem 0 1.25rem;
  }
  .hero-deck {
    max-width: 48rem;
    font-size: var(--text-lead);
    color: var(--color-stone);
    line-height: 1.6;
    margin: 0;
  }
  .detect-main {
    margin-block: 2rem 5rem;
  }

  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 900px) {
    .why-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .why-grid article {
    background: var(--color-vellum);
    padding: 1.5rem;
    border: 1px solid var(--color-rule);
  }
  .why-grid h3 {
    font-size: 1.125rem;
    margin: 0 0 0.75rem;
  }
  .why-grid p {
    font-size: 0.9375rem;
    color: var(--color-stone);
    line-height: 1.55;
    margin: 0;
  }
</style>
