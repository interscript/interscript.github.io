---
import Base from "../layouts/Base.astro"
import DiffViewer from "../components/DiffViewer.vue"

// Curated shortlist of related systems worth comparing.
const systemGroups = [
  {
    label: "Cyrillic (Russian)",
    systems: [
      { code: "bgnpcgn-rus-Cyrl-Latn-1947", label: "BGN/PCGN Russian (1947)" },
      { code: "odni-rus-Cyrl-Latn-2015", label: "ODNI Russian (2015)" },
      { code: "iso-rus-Cyrl-Latn-9-1995", label: "ISO 9 Russian (1995)" },
      { code: "alalc-rus-Cyrl-Latn-2012", label: "ALA-LC Russian (2012)" },
      { code: "un-rus-Cyrl-Latn-1987", label: "UN Russian (1987)" },
    ],
  },
]

const systems = systemGroups[0]!.systems
const initialLeft = systems[0]!.code
const initialRight = systems[2]!.code
---

<Base
  title="Compare map rules — Interscript"
  description="Side-by-side view of two transliteration systems' rule sets. See exactly where BGN/PCGN, ISO, ALA-LC, and ODNI diverge."
>
  <section class="diff-hero">
    <div class="container">
      <p class="eyebrow eyebrow-accent">Map diff</p>
      <h1>Where do two systems actually differ?</h1>
      <p class="hero-deck">
        Pick two transliteration systems and inspect their rule sets
        side-by-side. Each row is one transformation rule, exactly as
        it appears in the JSON IR. The first 30 rules of each map are
        shown — enough to spot the divergences that matter.
      </p>
    </div>
  </section>

  <section class="container diff-main">
    <DiffViewer
      client:load
      systems={systems}
      initialLeft={initialLeft}
      initialRight={initialRight}
    />
  </section>

  <section class="section why-diff surface-deep">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Why diff?</p>
        <h2>Choose with evidence.</h2>
        <p class="section-deck">
          Choosing between romanization systems is hard when the rules
          are buried in PDFs. The diff viewer surfaces the structural
          differences: which systems use parallel blocks, which add
          diacritics, which collapse distinctions.
        </p>
      </header>

      <div class="diff-cases">
        <article>
          <h3>Adoption decisions</h3>
          <p>
            Switching a newsroom or library from BGN/PCGN to ISO? See
            exactly what changes before you commit.
          </p>
        </article>
        <article>
          <h3>Map authoring</h3>
          <p>
            Writing a new map? Compare against an existing one to make
            sure you're not missing edge cases.
          </p>
        </article>
        <article>
          <h3>Linguistic research</h3>
          <p>
            Study how authorities have evolved their romanization
            conventions over time — pair an old system with a new one.
          </p>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .diff-hero {
    padding-block: 4rem 2.5rem;
  }
  .diff-hero h1 {
    font-size: var(--text-hero);
    margin: 1rem 0 1.25rem;
  }
  .hero-deck {
    max-width: 48rem;
    font-size: var(--text-lead);
    color: var(--color-stone);
    line-height: 1.6;
    margin: 0;
  }
  .diff-main {
    margin-block: 2rem 5rem;
  }

  .diff-cases {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 900px) {
    .diff-cases { grid-template-columns: repeat(3, 1fr); }
  }
  .diff-cases article {
    background: var(--color-vellum);
    padding: 1.5rem;
    border: 1px solid var(--color-rule);
  }
  .diff-cases h3 {
    font-size: 1.125rem;
    margin: 0 0 0.75rem;
  }
  .diff-cases p {
    font-size: 0.9375rem;
    color: var(--color-stone);
    line-height: 1.55;
    margin: 0;
  }
</style>
