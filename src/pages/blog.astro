---
import Base from "../layouts/Base.astro"
import { renderAsciiDocDir } from "../content/loaders/asciidoc"

const posts = renderAsciiDocDir("src/content/blog").map((p) => ({
  slug: p.id,
  date: p.data.date,
  title: p.data.title,
  author: p.data.author,
  summary: p.data.summary ?? "",
}))
---

<Base title="Blog — Interscript" description="Articles on transliteration, the Interscript project, and adjacent topics.">
  <h1>Blog</h1>
  <p class="lead">Long-form articles on transliteration engineering and research.</p>

  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <a href={`/blog/${p.slug}`}>
          <span class="date">{p.date}</span>
          <span class="title">{p.title}</span>
          {p.author && <span class="author">by {p.author}</span>}
          <span class="summary">{p.summary}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .lead {
    color: var(--color-stone);
    margin-bottom: 3rem;
  }
  .post-list {
    list-style: none;
    padding: 0;
  }
  .post-list li {
    border-bottom: 1px solid var(--color-rule);
  }
  .post-list a {
    display: block;
    padding: 1.5rem 0;
    text-decoration: none;
    color: var(--color-ink);
  }
  .post-list a:hover .title {
    color: var(--color-brand);
  }
  .date {
    display: block;
    color: var(--color-stone);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }
  .title {
    display: block;
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0.25rem 0 0.5rem;
  }
  .author {
    display: block;
    color: var(--color-stone);
    font-size: 0.9rem;
    font-style: italic;
    margin-bottom: 0.5rem;
  }
  .summary {
    display: block;
    color: var(--color-stone);
  }
</style>
