---
import "../styles/global.css"
import "@fontsource-variable/fraunces"
import "@fontsource-variable/inter-tight"
import "@fontsource/jetbrains-mono/400.css"
import "@fontsource/jetbrains-mono/500.css"

interface Props {
  title?: string
  description?: string
}

const {
  title = "Interscript — Interoperable Script Conversion",
  description = "Authority-backed transliteration systems for Ruby, TypeScript, and the browser. One map format, many runtimes.",
} = Astro.props

interface NavLink {
  href: string
  label: string
}

interface NavItem {
  href?: string
  label: string
  children?: NavLink[]
}

const navItems: NavItem[] = [
  { href: "/demo", label: "Demo" },
  {
    label: "Tools",
    children: [
      { href: "/compare", label: "Compare" },
      { href: "/batch", label: "Batch" },
      { href: "/detect", label: "Detect" },
      { href: "/diff", label: "Diff" },
      { href: "/marc", label: "MARC" },
      { href: "/subtitles", label: "Subtitles" },
    ],
  },
  { href: "/maps", label: "Maps" },
  { href: "/ml", label: "Models" },
  {
    label: "Developers",
    children: [
      { href: "/api", label: "API playground" },
      { href: "/api-docs", label: "API reference" },
      { href: "/status", label: "Status" },
    ],
  },
  {
    label: "Project",
    children: [
      { href: "/scripts", label: "Scripts" },
      { href: "/use-cases", label: "Use cases" },
      { href: "/authorities", label: "Authorities" },
      { href: "/contributing", label: "Contributing" },
      { href: "/docs", label: "Docs" },
      { href: "/about", label: "About" },
    ],
  },
]

const drawerGroups: Array<{ label: string; links: NavLink[] }> = [
  {
    label: "Try it",
    links: [
      { href: "/demo", label: "Live demo" },
      { href: "/compare", label: "Compare" },
      { href: "/batch", label: "Batch" },
      { href: "/detect", label: "Detect" },
      { href: "/diff", label: "Diff" },
      { href: "/marc", label: "MARC" },
      { href: "/subtitles", label: "Subtitles" },
    ],
  },
  {
    label: "Library",
    links: [
      { href: "/maps", label: "Map catalogue" },
      { href: "/ml", label: "Neural models" },
      { href: "/scripts", label: "Scripts" },
    ],
  },
  {
    label: "Developers",
    links: [
      { href: "/api", label: "API playground" },
      { href: "/api-docs", label: "API reference" },
      { href: "/status", label: "Status" },
    ],
  },
  {
    label: "Project",
    links: [
      { href: "/use-cases", label: "Use cases" },
      { href: "/authorities", label: "Authorities" },
      { href: "/contributing", label: "Contributing" },
      { href: "/docs", label: "Docs" },
      { href: "/about", label: "About" },
    ],
  },
]

const currentYear = new Date().getFullYear()
const currentPath = Astro.url.pathname

const isCurrent = (href: string) =>
  currentPath === href || currentPath.startsWith(href + "/")

const itemIsCurrent = (item: NavItem) =>
  (item.href !== undefined && isCurrent(item.href)) ||
  (item.children?.some((child) => isCurrent(child.href)) ?? false)

const slug = (label: string) => label.toLowerCase().replace(/\s+/g, "-")
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0e1620" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-card.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="Interscript home">
          <img src="/symbol.svg" alt="" class="brand-mark" width="22" height="22" />
          <span class="brand-name">Interscript</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <ul>
            {navItems.map((item) =>
              item.href ? (
                <li>
                  <a
                    href={item.href}
                    class:list={["nav-link", itemIsCurrent(item) && "is-active"]}
                    aria-current={item.href === currentPath ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ) : (
                <li class:list={["nav-item", itemIsCurrent(item) && "is-current"]}>
                  <button
                    type="button"
                    class="nav-trigger"
                    id={`nav-trigger-${slug(item.label)}`}
                    aria-expanded="false"
                    aria-haspopup="true"
                    aria-controls={`nav-menu-${slug(item.label)}`}
                  >
                    {item.label}
                    <svg class="nav-chevron" width="9" height="6" viewBox="0 0 9 6" fill="none" aria-hidden="true">
                      <path d="M1 1L4.5 4.5L8 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                  </button>
                  <div class="nav-menu" id={`nav-menu-${slug(item.label)}`}>
                    {item.children?.map((child) => (
                      <a
                        href={child.href}
                        class:list={["nav-menu-link", isCurrent(child.href) && "is-active"]}
                        aria-current={child.href === currentPath ? "page" : undefined}
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </li>
              )
            )}
          </ul>
        </nav>
        <div class="header-actions">
          <button
            class="theme-toggle"
            type="button"
            aria-label="Toggle dark mode"
            title="Toggle dark mode"
          >
            <span class="theme-toggle-icon" aria-hidden="true"></span>
          </button>
          <a class="github-pill" href="https://github.com/interscript" rel="noreferrer">
            GitHub ↗
          </a>
          <button
            class="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-drawer"
          >
            <span class="nav-toggle-box" aria-hidden="true">
              <span class="nav-toggle-bar"></span>
              <span class="nav-toggle-bar"></span>
            </span>
            <span class="visually-hidden">Menu</span>
          </button>
        </div>
      </div>
    </header>

    <div class="drawer-scrim" aria-hidden="true"></div>
    <nav class="site-drawer" id="site-drawer" aria-label="Menu">
      {drawerGroups.map((group) => (
        <div class="drawer-group">
          <h2 class="drawer-eyebrow">{group.label}</h2>
          <ul>
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={["drawer-link", isCurrent(link.href) && "is-active"]}
                  aria-current={link.href === currentPath ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="drawer-foot">
        <a class="drawer-github" href="https://github.com/interscript" rel="noreferrer">GitHub ↗</a>
      </div>
    </nav>

    <main class="site-main" id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <div class="brand-line">
            <img src="/symbol.svg" alt="" class="brand-mark footer-mark" width="24" height="24" />
            <span class="brand-name">Interscript</span>
          </div>
          <p class="footer-tag">
            Open-source transliteration systems from BGN/PCGN, ISO, UN,
            ALA-LC, ODNI, and other authorities.
          </p>
        </div>

        <nav class="footer-nav" aria-label="Footer">
          <div class="footer-col">
            <h4>Explore</h4>
            <ul>
              <li><a href="/demo">Live demo</a></li>
              <li><a href="/maps">Map catalogue</a></li>
              <li><a href="/ml">Model catalogue</a></li>
              <li><a href="/authorities">Authorities</a></li>
              <li><a href="/docs">Documentation</a></li>
              <li><a href="/docs/phonological-layer">Phonological layer</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4>Runtimes</h4>
            <ul>
              <li><a href="https://rubygems.org/gems/interscript" rel="noreferrer">Ruby gem</a></li>
              <li><a href="https://www.npmjs.com/package/interscript-ts" rel="noreferrer">TypeScript package</a></li>
              <li><a href="https://github.com/interscript/maps" rel="noreferrer">Map corpus</a></li>
              <li><a href="https://github.com/interscript/interscript-ruby" rel="noreferrer">Ruby source</a></li>
              <li><a href="https://www.secryst.org" rel="noreferrer">secryst crystals</a></li>
              <li><a href="https://github.com/interscript/interscript-ml" rel="noreferrer">interscript-ml contract</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4>Maintained by</h4>
            <ul>
              <li><a href="https://www.ribose.com" rel="noreferrer">Ribose Inc.</a></li>
              <li><a href="https://github.com/interscript" rel="noreferrer">GitHub org</a></li>
              <li><a href="https://github.com/interscript/interscript.org/blob/main/SECURITY.md" rel="noreferrer">Security policy</a></li>
              <li><a href="/about">About &amp; funding</a></li>
            </ul>
          </div>
        </nav>
      </div>

      <div class="container footer-base">
        <p class="footer-legal">
          © {currentYear} Ribose Inc. · BSD-2-Clause
        </p>
      </div>
    </footer>

    <script is:inline>
      // Apply saved theme before paint to avoid FOUC.
      (function () {
        const saved = localStorage.getItem("isx-theme")
        if (saved === "dark" || saved === "light") {
          document.documentElement.setAttribute("data-theme", saved)
        }
      })()
    </script>

    <script>
      import "/src/scripts/theme-toggle.ts"
    </script>

    <script>
      const navToggle = document.querySelector<HTMLButtonElement>(".nav-toggle")
      const drawer = document.getElementById("site-drawer")
      const items = Array.from(document.querySelectorAll<HTMLElement>(".nav-item"))

      function closeMenus(except?: HTMLElement) {
        for (const item of items) {
          if (item === except) continue
          item.classList.remove("is-open")
          item.querySelector(".nav-trigger")?.setAttribute("aria-expanded", "false")
        }
      }

      for (const item of items) {
        const trigger = item.querySelector<HTMLButtonElement>(".nav-trigger")
        if (!trigger) continue
        trigger.addEventListener("click", (e) => {
          e.stopPropagation()
          // A hover-opened menu consumes the first click as "pin open"
          // instead of toggling straight back closed.
          if (item.dataset.hover === "1") {
            delete item.dataset.hover
            return
          }
          const open = item.classList.toggle("is-open")
          trigger.setAttribute("aria-expanded", String(open))
          closeMenus(item)
        })
        item.addEventListener("mouseenter", () => {
          if (!window.matchMedia("(hover: hover) and (min-width: 1024px)").matches) return
          closeMenus(item)
          item.classList.add("is-open")
          item.dataset.hover = "1"
          trigger.setAttribute("aria-expanded", "true")
        })
        item.addEventListener("mouseleave", () => {
          delete item.dataset.hover
          item.classList.remove("is-open")
          trigger.setAttribute("aria-expanded", "false")
        })
      }

      document.addEventListener("click", (e) => {
        if (!(e.target instanceof Element)) return
        if (!e.target.closest(".nav-item")) closeMenus()
      })

      function closeDrawer(returnFocus: boolean) {
        document.body.classList.remove("nav-open")
        navToggle?.setAttribute("aria-expanded", "false")
        document.body.style.overflow = ""
        if (returnFocus) navToggle?.focus()
      }

      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return
        if (document.body.classList.contains("nav-open")) {
          closeDrawer(true)
          return
        }
        const open = document.querySelector<HTMLElement>(".nav-item.is-open")
        if (open) {
          open.classList.remove("is-open")
          open.querySelector(".nav-trigger")?.setAttribute("aria-expanded", "false")
          open.querySelector<HTMLButtonElement>(".nav-trigger")?.focus()
        }
      })

      navToggle?.addEventListener("click", () => {
        if (document.body.classList.contains("nav-open")) {
          closeDrawer(true)
          return
        }
        document.body.classList.add("nav-open")
        navToggle.setAttribute("aria-expanded", "true")
        document.body.style.overflow = "hidden"
        drawer?.querySelector<HTMLElement>("a, button")?.focus()
      })

      document.querySelector(".drawer-scrim")?.addEventListener("click", () => closeDrawer(false))

      window
        .matchMedia("(min-width: 1024px)")
        .addEventListener("change", (e) => {
          if (e.matches && document.body.classList.contains("nav-open")) closeDrawer(false)
          closeMenus()
        })
    </script>

    <script is:inline>
      // Register the service worker for offline-first access.
      // Skipped during SSR build (no window) and on insecure origins.
      if (typeof window !== "undefined" &&
          "serviceWorker" in navigator &&
          window.location.protocol.startsWith("http")) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            // Silent failure — site still works without SW.
          })
        })
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--color-ink);
        color: var(--color-vellum);
        font-family: var(--font-mono);
        font-size: var(--text-micro);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 0.75rem 1.25rem;
        text-decoration: none;
      }
      .skip-link:focus { left: 0; }
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
      }
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--color-paper) 88%, transparent);
        backdrop-filter: saturate(140%) blur(10px);
        border-bottom: 1px solid var(--color-rule);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding-block: 0.875rem;
      }
      .brand {
        display: inline-flex;
        align-items: baseline;
        gap: 0.5rem;
        text-decoration: none;
        color: var(--color-ink);
        flex-shrink: 0;
      }
      .brand-mark {
        display: inline-block;
        width: 22px;
        height: 22px;
        vertical-align: middle;
        flex-shrink: 0;
        /* Slight tilt to evoke the parallelogram's bias */
        transform: skewY(-2deg);
      }
      .brand-name {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 1.25rem;
        letter-spacing: -0.015em;
      }
      .site-nav ul {
        display: flex;
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 1.4rem;
      }
      .nav-link,
      .nav-trigger {
        font-family: var(--font-sans);
        font-size: 0.9375rem;
        font-weight: 500;
        color: var(--color-ink);
        text-decoration: none;
        padding-block: 0.25rem;
        position: relative;
        transition: color 0.15s ease;
      }
      .nav-trigger {
        background: none;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
      }
      .nav-chevron {
        transition: transform 0.15s ease;
        margin-top: 1px;
      }
      .nav-trigger[aria-expanded="true"] .nav-chevron {
        transform: rotate(180deg);
      }
      .nav-link:hover,
      .nav-trigger:hover {
        color: var(--color-highlight);
      }
      .nav-link:focus-visible,
      .nav-trigger:focus-visible {
        outline: 2px solid var(--color-ochre);
        outline-offset: 2px;
      }
      .nav-link.is-active { color: var(--color-highlight); }
      .nav-link.is-active::after,
      .nav-item.is-current > .nav-trigger::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        bottom: -0.3rem;
        height: 2px;
        background: var(--color-highlight);
      }
      .nav-item.is-current > .nav-trigger { color: var(--color-highlight); }
      .nav-item { position: relative; }
      .nav-menu {
        position: absolute;
        top: calc(100% + 0.6rem);
        left: -0.9rem;
        min-width: 13rem;
        background: var(--color-vellum);
        border: 1px solid var(--color-rule-strong);
        border-radius: 2px;
        padding: 0.5rem;
        display: grid;
        gap: 2px;
        box-shadow: 0 12px 32px -12px color-mix(in srgb, var(--color-ink) 30%, transparent);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-4px);
        transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
        z-index: 60;
      }
      .nav-item.is-open > .nav-menu,
      .nav-item:focus-within > .nav-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }
      .nav-menu-link {
        font-family: var(--font-sans);
        font-size: 0.9375rem;
        color: var(--color-ink);
        text-decoration: none;
        padding: 0.5rem 0.75rem;
        border-radius: 1px;
        transition: background 0.12s ease, color 0.12s ease;
      }
      .nav-menu-link:hover {
        background: color-mix(in srgb, var(--color-ink) 5%, transparent);
        color: var(--color-highlight);
      }
      .nav-menu-link:focus-visible {
        outline: 2px solid var(--color-ochre);
        outline-offset: -2px;
      }
      .nav-menu-link.is-active { color: var(--color-highlight); font-weight: 500; }
      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-shrink: 0;
      }
      .theme-toggle {
        background: transparent;
        border: 1px solid var(--color-rule-strong);
        width: 32px;
        height: 32px;
        padding: 0;
        cursor: pointer;
        border-radius: 1px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background 0.15s ease, border-color 0.15s ease;
      }
      .theme-toggle:hover {
        border-color: var(--color-brand);
      }
      .theme-toggle:focus-visible {
        outline: 2px solid var(--color-ochre);
        outline-offset: 2px;
      }
      .theme-toggle-icon {
        display: inline-block;
        width: 14px;
        height: 14px;
        position: relative;
      }
      /* Sun icon for light mode */
      .theme-toggle-icon::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at center, var(--color-ink) 35%, transparent 36%);
      }
      /* Moon icon for dark mode */
      .theme-toggle-icon[data-state="dark"]::before {
        background:
          radial-gradient(circle at 30% 30%, transparent 50%, var(--color-ink) 51%);
      }
      .github-pill {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        text-decoration: none;
        color: var(--color-ink);
        border: 1.5px solid var(--color-ink);
        padding: 0.4rem 0.95rem;
        border-radius: 1px;
        transition: background 0.15s ease, color 0.15s ease;
        text-transform: uppercase;
      }
      .github-pill:hover {
        background: var(--color-ink);
        color: var(--color-vellum);
      }
      .github-pill:focus-visible,
      .nav-toggle:focus-visible {
        outline: 2px solid var(--color-ochre);
        outline-offset: 2px;
      }
      .nav-toggle {
        display: none;
        background: transparent;
        border: 1px solid var(--color-rule-strong);
        width: 36px;
        height: 32px;
        padding: 0;
        cursor: pointer;
        border-radius: 1px;
        align-items: center;
        justify-content: center;
      }
      .nav-toggle-box {
        position: relative;
        width: 16px;
        height: 12px;
        display: block;
      }
      .nav-toggle-bar {
        position: absolute;
        left: 0;
        right: 0;
        height: 1.5px;
        background: var(--color-ink);
        transition: transform 0.2s ease, top 0.2s ease;
      }
      .nav-toggle-bar:nth-child(1) { top: 2px; }
      .nav-toggle-bar:nth-child(2) { top: 8px; }
      body.nav-open .nav-toggle-bar:nth-child(1) { top: 5px; transform: rotate(45deg); }
      body.nav-open .nav-toggle-bar:nth-child(2) { top: 5px; transform: rotate(-45deg); }
      .site-drawer {
        position: fixed;
        inset-block: 0;
        right: 0;
        width: min(22rem, 90vw);
        background: var(--color-vellum);
        border-left: 1px solid var(--color-rule-strong);
        z-index: 70;
        padding: 1.75rem 1.5rem 2rem;
        overflow-y: auto;
        display: grid;
        gap: 1.75rem;
        align-content: start;
        transform: translateX(100%);
        visibility: hidden;
        transition: transform 0.25s ease, visibility 0.25s;
      }
      body.nav-open .site-drawer {
        transform: translateX(0);
        visibility: visible;
      }
      .drawer-scrim {
        position: fixed;
        inset: 0;
        background: color-mix(in srgb, var(--color-ink) 45%, transparent);
        z-index: 60;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.25s ease, visibility 0.25s;
      }
      body.nav-open .drawer-scrim {
        opacity: 1;
        visibility: visible;
      }
      .drawer-eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-micro);
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--color-stone);
        font-weight: 500;
        margin: 0 0 0.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--color-rule);
      }
      .drawer-group ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
      }
      .drawer-link {
        display: block;
        font-family: var(--font-sans);
        font-size: 1.0625rem;
        color: var(--color-ink);
        text-decoration: none;
        padding: 0.5rem 0.25rem;
      }
      .drawer-link:hover { color: var(--color-highlight); }
      .drawer-link:focus-visible {
        outline: 2px solid var(--color-ochre);
        outline-offset: 2px;
      }
      .drawer-link.is-active { color: var(--color-highlight); }
      .drawer-foot {
        border-top: 1px solid var(--color-rule);
        padding-top: 1.25rem;
      }
      .drawer-github {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--color-ink);
        text-decoration: none;
        border: 1.5px solid var(--color-ink);
        padding: 0.4rem 0.95rem;
